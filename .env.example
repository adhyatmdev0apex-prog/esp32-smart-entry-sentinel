# Smart Entry Sentinel — Local Environment Configuration
# Copy this file to .env and customize for your network & GitHub repo.

# Ports
PORT=5000
CONTROL_CENTER_PORT=5001

# LAN mDNS hostname (reachable at http://<MDNS_HOST>.local:5000)
MDNS_HOST=doorcam

# ESP32 Device IPs
ESP32_CAM_IP=192.168.29.10
ESP32_WROOM_IP=192.168.29.20

# GitHub Repository for Control Center release updates (owner/repo)
GITHUB_REPO=AdhyatmDeharia/Smart-Door-Entry-Detection

# Optional: Override Wi-Fi & Dashboard Credentials on Docker startup
# (Leave blank to manage manually in firmware/esp32-cam/include/secrets.h)
WIFI_SSID=
WIFI_PASSWORD=
ADMIN_PASSWORD=
USER_PASSWORD=
