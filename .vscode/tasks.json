{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "PlatformIO: Build ESP32-CAM",
			"type": "shell",
			"command": "pio",
			"args": [
				"run"
			],
			"options": {
				"cwd": "${workspaceFolder:ESP32-CAM Firmware}"
			},
			"problemMatcher": []
		},
		{
			"label": "PlatformIO: Upload ESP32-CAM",
			"type": "shell",
			"command": "pio",
			"args": [
				"run",
				"--target",
				"upload"
			],
			"options": {
				"cwd": "${workspaceFolder:ESP32-CAM Firmware}"
			},
			"problemMatcher": []
		},
		{
			"label": "Upload via Wi-Fi (OTA)",
			"type": "shell",
			"command": "python",
			"args": [
				"ota_upload.py"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "PlatformIO: Monitor ESP32-CAM",
			"type": "shell",
			"command": "pio",
			"args": [
				"device",
				"monitor"
			],
			"options": {
				"cwd": "${workspaceFolder:ESP32-CAM Firmware}"
			},
			"problemMatcher": []
		}
	]
}